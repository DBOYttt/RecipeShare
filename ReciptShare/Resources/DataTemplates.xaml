<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:models="clr-namespace:ReciptShare.Models">

    <!-- Recipe Card Template -->
    <DataTemplate x:Key="RecipeCardTemplate" x:DataType="models:Recipe">
        <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
               HasShadow="True" 
               CornerRadius="15" 
               Margin="0,8,0,8"
               Padding="0">
            
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToRecipeDetailCommand}"
                                      CommandParameter="{Binding .}" />
            </Frame.GestureRecognizers>

            <Grid RowDefinitions="200,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                
                <!-- Recipe Image -->
                <Frame Grid.Row="0" Grid.ColumnSpan="2" 
                       BackgroundColor="#E0E0E0" 
                       CornerRadius="15,15,0,0" 
                       Padding="0"
                       Margin="0">
                    <Grid>
                        <Image Source="{Binding ImageUrl}" 
                               Aspect="AspectFill"
                               HeightRequest="200" />
                        <Label Text="🍽️" 
                               FontSize="40" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"
                               IsVisible="{Binding ImageUrl, Converter={StaticResource IsStringNullOrEmptyConverter}}" />
                    </Grid>
                </Frame>

                <!-- Recipe Title -->
                <Label Grid.Row="1" Grid.Column="0"
                       Text="{Binding Title}" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                       Margin="15,10,10,5"
                       LineBreakMode="TailTruncation" />

                <!-- Author -->
                <Label Grid.Row="2" Grid.Column="0"
                       Text="{Binding AuthorName, StringFormat='by {0}'}" 
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                       Margin="15,0,10,5" />

                <!-- Recipe Stats -->
                <StackLayout Grid.Row="3" Grid.Column="0" 
                             Orientation="Horizontal" 
                             Margin="15,0,10,15">
                    <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" 
                           FontSize="12" 
                           TextColor="#FF9800" />
                    <Label Text="•" FontSize="12" Margin="8,0" 
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="{Binding TotalTimeMinutes, StringFormat='{0} min'}" 
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="•" FontSize="12" Margin="8,0"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="{Binding Difficulty}" 
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                </StackLayout>

                <!-- Favorite Button -->
                <Button Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                        Text="{Binding IsFavorited, Converter={StaticResource BoolToHeartConverter}}"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        WidthRequest="50"
                        HeightRequest="50"
                        Margin="0,10,15,0"
                        VerticalOptions="Start"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToFavoritesCommand}"
                        CommandParameter="{Binding .}" />

            </Grid>
        </Frame>
    </DataTemplate>

    <!-- Compact Recipe Card Template -->
    <DataTemplate x:Key="CompactRecipeCardTemplate" x:DataType="models:Recipe">
        <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
               HasShadow="True" 
               CornerRadius="10" 
               Margin="0,5"
               Padding="10">
            
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToRecipeDetailCommand}"
                                      CommandParameter="{Binding .}" />
            </Frame.GestureRecognizers>

            <Grid ColumnDefinitions="80,*,Auto" RowDefinitions="Auto,Auto,Auto">
                
                <!-- Recipe Image Thumbnail -->
                <Frame Grid.Column="0" Grid.RowSpan="3" 
                       BackgroundColor="#E0E0E0" 
                       WidthRequest="70" 
                       HeightRequest="70" 
                       CornerRadius="10" 
                       Margin="0,0,15,0"
                       Padding="0">
                    <Grid>
                        <Image Source="{Binding ImageUrl}" 
                               Aspect="AspectFill" />
                        <Label Text="🍽️" 
                               FontSize="25" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"
                               IsVisible="{Binding ImageUrl, Converter={StaticResource IsStringNullOrEmptyConverter}}" />
                    </Grid>
                </Frame>
                
                <!-- Recipe Info -->
                <Label Grid.Column="1" Grid.Row="0" 
                       Text="{Binding Title}" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                       LineBreakMode="TailTruncation" />
                
                <Label Grid.Column="1" Grid.Row="1" 
                       Text="{Binding AuthorName, StringFormat='by {0}'}" 
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                
                <StackLayout Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                    <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="12" TextColor="#FF9800" />
                    <Label Text="•" FontSize="12" Margin="5,0" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="{Binding TotalTimeMinutes, StringFormat='{0} min'}" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="•" FontSize="12" Margin="5,0" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="{Binding Difficulty}" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                </StackLayout>
                
                <!-- Like Button -->
                <Button Grid.Column="2" Grid.RowSpan="3"
                        Text="{Binding IsFavorited, Converter={StaticResource BoolToHeartConverter}}"
                        FontSize="20"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToFavoritesCommand}"
                        CommandParameter="{Binding .}" />
            </Grid>
        </Frame>
    </DataTemplate>

</ResourceDictionary>