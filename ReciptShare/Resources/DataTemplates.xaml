<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:models="clr-namespace:ReciptShare.Models">

    <!-- Existing RecipeCardTemplate -->
    <DataTemplate x:Key="RecipeCardTemplate" x:DataType="models:Recipe">
        <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
               HasShadow="True" 
               CornerRadius="15" 
               Margin="0,10"
               Padding="0">
            
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToRecipeDetailCommand}"
                                      CommandParameter="{Binding .}" />
            </Frame.GestureRecognizers>

            <Grid RowDefinitions="200,Auto,Auto,Auto">
                
                <!-- Recipe Image -->
                <Frame Grid.Row="0" BackgroundColor="#E0E0E0" CornerRadius="15,15,0,0" Padding="0" Margin="0">
                    <Grid>
                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="200" />
                        <Label Text="🍽️" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding ImageUrl, Converter={StaticResource IsStringNullOrEmptyConverter}}" />
                        
                        <!-- Favorite Button -->
                        <Button Text="{Binding IsFavorited, Converter={StaticResource BoolToHeartConverter}}" 
                                FontSize="24"
                                BackgroundColor="#80FFFFFF"
                                TextColor="#FF4444"
                                CornerRadius="20"
                                WidthRequest="40"
                                HeightRequest="40"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="15"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFavoriteCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </Frame>

                <!-- Recipe Title -->
                <Label Grid.Row="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                       Margin="15,15,15,5" LineBreakMode="TailTruncation" />

                <!-- Author -->
                <Label Grid.Row="2" Text="{Binding AuthorName, StringFormat='by {0}'}" FontSize="14"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                       Margin="15,0,15,5" />

                <!-- Recipe Stats -->
                <StackLayout Grid.Row="3" Orientation="Horizontal" Margin="15,0,15,15">
                    <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="12" TextColor="#FF9800" />
                    <Label Text="•" FontSize="12" Margin="8,0" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="{Binding TotalTimeMinutes, StringFormat='{0} min'}" FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="•" FontSize="12" Margin="8,0" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="{Binding Difficulty}" FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                </StackLayout>

            </Grid>
        </Frame>
    </DataTemplate>

    <!-- New CompactRecipeCardTemplate -->
    <DataTemplate x:Key="CompactRecipeCardTemplate" x:DataType="models:Recipe">
        <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
               HasShadow="True" 
               CornerRadius="10" 
               Margin="0,5"
               Padding="15">
            
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToRecipeDetailCommand}"
                                      CommandParameter="{Binding .}" />
            </Frame.GestureRecognizers>

            <Grid ColumnDefinitions="60,*,Auto">
                
                <!-- Recipe Image Thumbnail -->
                <Frame Grid.Column="0" BackgroundColor="#E0E0E0" CornerRadius="8" Padding="0" WidthRequest="60" HeightRequest="60">
                    <Grid>
                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                        <Label Text="🍽️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding ImageUrl, Converter={StaticResource IsStringNullOrEmptyConverter}}" />
                    </Grid>
                </Frame>

                <!-- Recipe Info -->
                <StackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                           LineBreakMode="TailTruncation" />
                    
                    <StackLayout Orientation="Horizontal">
                        <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="12" TextColor="#FF9800" />
                        <Label Text="•" FontSize="12" Margin="5,0" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                        <Label Text="{Binding TotalTimeMinutes, StringFormat='{0} min'}" FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    </StackLayout>
                </StackLayout>

                <!-- Favorite Button -->
                <Button Grid.Column="2" 
                        Text="{Binding IsFavorited, Converter={StaticResource BoolToHeartConverter}}" 
                        FontSize="20"
                        BackgroundColor="Transparent"
                        TextColor="#FF4444"
                        WidthRequest="40"
                        HeightRequest="40"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFavoriteCommand}"
                        CommandParameter="{Binding .}" />

            </Grid>
        </Frame>
    </DataTemplate>

</ResourceDictionary>