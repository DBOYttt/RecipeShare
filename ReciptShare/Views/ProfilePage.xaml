<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReciptShare.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ReciptShare.ViewModels"
             xmlns:models="clr-namespace:ReciptShare.Models"
             x:DataType="viewmodels:ProfileViewModel"
             Title="{Binding CurrentUser.Username}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Share" 
                     Command="{Binding ShareProfileCommand}"
                     IconImageSource="share_icon.png" />
        <ToolbarItem Text="Edit" 
                     Command="{Binding EditProfileCommand}"
                     IconImageSource="edit_icon.png" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                 Command="{Binding RefreshProfileCommand}">
        <ScrollView>
            <StackLayout Padding="0">
                
                <!-- Profile Header -->
                <Frame BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}" 
                       CornerRadius="0,0,30,30"
                       Padding="30,40,30,30"
                       Margin="0,0,0,20">
                    <StackLayout>
                        <!-- Profile Picture -->
                        <Frame BackgroundColor="White" 
                               CornerRadius="60" 
                               WidthRequest="120" 
                               HeightRequest="120"
                               HorizontalOptions="Center"
                               Padding="0"
                               HasShadow="True">
                            <Grid>
                                <Ellipse Fill="#E0E0E0" 
                                        WidthRequest="110" 
                                        HeightRequest="110" />
                                <Image Source="{Binding CurrentUser.ProfileImageUrl}" 
                                       WidthRequest="110" 
                                       HeightRequest="110"
                                       Aspect="AspectFill" />
                                <Label Text="👨‍🍳" 
                                       FontSize="50" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding CurrentUser.ProfileImageUrl, Converter={StaticResource IsStringNullOrEmptyConverter}}" />
                            </Grid>
                        </Frame>

                        <!-- User Info -->
                        <Label Text="{Binding CurrentUser.FullName}" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="White"
                               Margin="0,15,0,5" />
                        
                        <Label Text="{Binding CurrentUser.Username, StringFormat='@{0}'}" 
                               FontSize="18" 
                               HorizontalOptions="Center"
                               TextColor="#E3F2FD"
                               Margin="0,0,0,10" />

                        <Label Text="{Binding CurrentUser.Bio}" 
                               FontSize="16" 
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="White"
                               Margin="0,0,0,20" />

                        <!-- Stats -->
                        <Grid ColumnDefinitions="*,*,*" Margin="0,10,0,0">
                            <StackLayout Grid.Column="0" HorizontalOptions="Center">
                                <Label Text="{Binding CurrentUser.RecipesCount}" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center"
                                       TextColor="White" />
                                <Label Text="Recipes" 
                                       FontSize="14" 
                                       HorizontalOptions="Center"
                                       TextColor="#E3F2FD" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="{Binding CurrentUser.FollowersCount}" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center"
                                       TextColor="White" />
                                <Label Text="Followers" 
                                       FontSize="14" 
                                       HorizontalOptions="Center"
                                       TextColor="#E3F2FD" />
                            </StackLayout>
                            <StackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="{Binding CurrentUser.FollowingCount}" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center"
                                       TextColor="White" />
                                <Label Text="Following" 
                                       FontSize="14" 
                                       HorizontalOptions="Center"
                                       TextColor="#E3F2FD" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Frame>

                <StackLayout Padding="20,0,20,20">
                    
                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,0,0,30">
                        <Button Grid.Column="0"
                                Text="✏️ Edit Profile"
                                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="50"
                                Command="{Binding EditProfileCommand}" />
                        
                        <Button Grid.Column="1"
                                Text="➕ Add Recipe"
                                BackgroundColor="{AppThemeBinding Light=#FF9800, Dark=#F57C00}"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="50"
                                Command="{Binding AddNewRecipeCommand}" />
                    </Grid>

                    <!-- Tab Navigation -->
                    <ScrollView Orientation="Horizontal" HeightRequest="50" Margin="0,0,0,20">
                        <StackLayout Orientation="Horizontal">
                            <Button Text="📝 My Recipes" 
                                    BackgroundColor="{Binding SelectedTab, Converter={StaticResource TabToColorConverter}, ConverterParameter='Recipes'}"
                                    TextColor="{Binding SelectedTab, Converter={StaticResource TabToTextColorConverter}, ConverterParameter='Recipes'}"
                                    CornerRadius="20" 
                                    Margin="5,0"
                                    Padding="20,10"
                                    Command="{Binding ShowRecipesCommand}" />
                            <Button Text="📊 Stats" 
                                    BackgroundColor="{Binding SelectedTab, Converter={StaticResource TabToColorConverter}, ConverterParameter='Stats'}"
                                    TextColor="{Binding SelectedTab, Converter={StaticResource TabToTextColorConverter}, ConverterParameter='Stats'}"
                                    CornerRadius="20" 
                                    Margin="5,0"
                                    Padding="20,10"
                                    Command="{Binding ShowStatsCommand}" />
                            <Button Text="⚙️ Settings" 
                                    BackgroundColor="{Binding SelectedTab, Converter={StaticResource TabToColorConverter}, ConverterParameter='Settings'}"
                                    TextColor="{Binding SelectedTab, Converter={StaticResource TabToTextColorConverter}, ConverterParameter='Settings'}"
                                    CornerRadius="20" 
                                    Margin="5,0"
                                    Padding="20,10"
                                    Command="{Binding ShowSettingsCommand}" />
                        </StackLayout>
                    </ScrollView>

                    <!-- Content Based on Selected Tab -->
                    
                    <!-- Recipes Tab -->
                    <StackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Recipes'}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                            <Label Grid.Column="0"
                                   Text="{Binding UserRecipes.Count, StringFormat='My Recipes ({0})'}" 
                                   FontSize="20" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                            
                            <Button Grid.Column="1"
                                    Text="View All"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}"
                                    FontSize="14"
                                    Command="{Binding ViewAllRecipesCommand}" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding RecentRecipes}"
                                        ItemTemplate="{StaticResource CompactRecipeCardTemplate}"
                                        HeightRequest="300">
                            <CollectionView.EmptyView>
                                <ContentView>
                                    <StackLayout Padding="50" VerticalOptions="Center">
                                        <Label Text="📝" 
                                               FontSize="60" 
                                               HorizontalOptions="Center"
                                               Margin="0,0,0,15" />
                                        <Label Text="No Recipes Yet" 
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                                        <Label Text="Share your first recipe with the community!" 
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               Margin="0,5,0,20"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                        <Button Text="Create Recipe"
                                                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                                                TextColor="White"
                                                CornerRadius="25"
                                                Padding="30,15"
                                                Command="{Binding AddNewRecipeCommand}" />
                                    </StackLayout>
                                </ContentView>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </StackLayout>

                    <!-- Stats Tab -->
                    <StackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Stats'}">
                        <Label Text="📊 Your Recipe Statistics" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               Margin="0,0,0,20"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="15" ColumnSpacing="15">
                            <!-- Total Likes -->
                            <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFE0E0, Dark=#D32F2F}" Padding="20" CornerRadius="15">
                                <StackLayout HorizontalOptions="Center">
                                    <Label Text="❤️" FontSize="30" HorizontalOptions="Center" />
                                    <Label Text="{Binding TotalLikes}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Total Likes" FontSize="14" HorizontalOptions="Center" />
                                </StackLayout>
                            </Frame>

                            <!-- Average Rating -->
                            <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#F57C00}" Padding="20" CornerRadius="15">
                                <StackLayout HorizontalOptions="Center">
                                    <Label Text="⭐" FontSize="30" HorizontalOptions="Center" />
                                    <Label Text="{Binding AverageRating, StringFormat='{0:F1}'}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Avg Rating" FontSize="14" HorizontalOptions="Center" />
                                </StackLayout>
                            </Frame>

                            <!-- Total Views -->
                            <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#388E3C}" Padding="20" CornerRadius="15">
                                <StackLayout HorizontalOptions="Center">
                                    <Label Text="👀" FontSize="30" HorizontalOptions="Center" />
                                    <Label Text="{Binding TotalViews}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Total Views" FontSize="14" HorizontalOptions="Center" />
                                </StackLayout>
                            </Frame>

                            <!-- Member Since -->
                            <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1976D2}" Padding="20" CornerRadius="15">
                                <StackLayout HorizontalOptions="Center">
                                    <Label Text="📅" FontSize="30" HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentUser.JoinDate, StringFormat='{0:MMM yyyy}'}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Member Since" FontSize="14" HorizontalOptions="Center" />
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </StackLayout>

                    <!-- Settings Tab -->
                    <StackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Settings'}">
                        <Label Text="⚙️ Settings" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               Margin="0,0,0,20"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />

                        <!-- Settings Options -->
                        <Frame BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2D2D30}" CornerRadius="15" Padding="0" Margin="0,0,0,20">
                            <StackLayout>
                                <!-- Notifications -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20" BackgroundColor="Transparent">
                                    <Label Grid.Column="0" Text="🔔" FontSize="24" VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                        <Label Text="Notifications" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                                        <Label Text="Manage your notification preferences" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                    </StackLayout>
                                    <Button Grid.Column="2" Text=">" FontSize="20" BackgroundColor="Transparent" WidthRequest="30" Command="{Binding ManageNotificationsCommand}" />
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" Margin="20,0" />

                                <!-- Privacy -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20" BackgroundColor="Transparent">
                                    <Label Grid.Column="0" Text="🔒" FontSize="24" VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                        <Label Text="Privacy" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                                        <Label Text="Control your privacy settings" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                    </StackLayout>
                                    <Button Grid.Column="2" Text=">" FontSize="20" BackgroundColor="Transparent" WidthRequest="30" Command="{Binding ManagePrivacyCommand}" />
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" Margin="20,0" />

                                <!-- Help & Support (Fixed - escaped &) -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20" BackgroundColor="Transparent">
                                    <Label Grid.Column="0" Text="❓" FontSize="24" VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                        <Label Text="Help &amp; Support" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                                        <Label Text="Get help and contact support" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                    </StackLayout>
                                    <Button Grid.Column="2" Text=">" FontSize="20" BackgroundColor="Transparent" WidthRequest="30" Command="{Binding ViewHelpCommand}" />
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" Margin="20,0" />

                                <!-- About -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20" BackgroundColor="Transparent">
                                    <Label Grid.Column="0" Text="ℹ️" FontSize="24" VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                        <Label Text="About RecipeShare" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                                        <Label Text="App version and information" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                    </StackLayout>
                                    <Button Grid.Column="2" Text=">" FontSize="20" BackgroundColor="Transparent" WidthRequest="30" Command="{Binding ViewAboutCommand}" />
                                </Grid>
                            </StackLayout>
                        </Frame>

                        <!-- Account Actions -->
                        <StackLayout Spacing="15">
                            <Button Text="🚪 Sign Out"
                                    BackgroundColor="{AppThemeBinding Light=#FF9800, Dark=#F57C00}"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="50"
                                    Command="{Binding SignOutCommand}" />
                            
                            <Button Text="🗑️ Delete Account"
                                    BackgroundColor="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="50"
                                    Command="{Binding DeleteAccountCommand}" />
                        </StackLayout>
                    </StackLayout>

                </StackLayout>
            </StackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>