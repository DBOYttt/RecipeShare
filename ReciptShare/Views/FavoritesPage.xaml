<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReciptShare.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ReciptShare.ViewModels"
             xmlns:models="clr-namespace:ReciptShare.Models"
             x:DataType="viewmodels:FavoritesViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sort" 
                     Command="{Binding ShowSortOptionsCommand}"
                     IconImageSource="sort_icon.png" />
        <ToolbarItem Text="Clear All" 
                     Command="{Binding ClearAllFavoritesCommand}"
                     IconImageSource="delete_icon.png" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                 Command="{Binding RefreshFavoritesCommand}">
        <ScrollView>
            <StackLayout Padding="20">
                
                <!-- Header Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2D2D30}" 
                       HasShadow="True" 
                       CornerRadius="15" 
                       Margin="0,0,0,20"
                       Padding="20">
                    <StackLayout>
                        <Label Text="❤️" 
                               FontSize="40" 
                               HorizontalOptions="Center" />
                        <Label Text="Your Favorite Recipes" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                        <Label Text="{Binding FavoriteRecipes.Count, StringFormat='{0} recipes saved'}" 
                               FontSize="16" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    </StackLayout>
                </Frame>

                <!-- Sort Information -->
                <Grid ColumnDefinitions="*,Auto" 
                      Margin="0,0,0,20"
                      IsVisible="{Binding FavoriteRecipes.Count, Converter={StaticResource IntToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="{Binding FavoriteRecipes.Count, StringFormat='Showing {0} favorite recipes'}" 
                           FontSize="16" 
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                    
                    <Button Grid.Column="1"
                            Text="{Binding SortOption, StringFormat='📊 {0}'}"
                            BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1976D2}"
                            TextColor="{AppThemeBinding Light=#1976D2, Dark=#FFFFFF}"
                            CornerRadius="20"
                            Padding="15,8"
                            FontSize="14"
                            Command="{Binding ShowSortOptionsCommand}" />
                </Grid>

                <!-- Favorites List -->
                <CollectionView ItemsSource="{Binding FavoriteRecipes}"
                                ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Recipe">
                            <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
                                   HasShadow="True" 
                                   CornerRadius="15" 
                                   Margin="0,8"
                                   Padding="0">
                                
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToRecipeDetailCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid RowDefinitions="200,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    
                                    <!-- Recipe Image -->
                                    <Frame Grid.Row="0" Grid.ColumnSpan="2" 
                                           BackgroundColor="#E0E0E0" 
                                           CornerRadius="15,15,0,0" 
                                           Padding="0"
                                           Margin="0">
                                        <Grid>
                                            <Image Source="{Binding ImageUrl}" 
                                                   Aspect="AspectFill"
                                                   HeightRequest="200" />
                                            <Label Text="🍽️" 
                                                   FontSize="50" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding ImageUrl, Converter={StaticResource IsStringNullOrEmptyConverter}}" />
                                            
                                            <!-- Favorite Badge -->
                                            <Frame BackgroundColor="#FF4444" 
                                                   CornerRadius="15"
                                                   Padding="8,4"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Start"
                                                   Margin="15">
                                                <Label Text="❤️ Favorite" 
                                                       TextColor="White" 
                                                       FontSize="12"
                                                       FontAttributes="Bold" />
                                            </Frame>
                                        </Grid>
                                    </Frame>

                                    <!-- Recipe Title -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Title}" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                                           Margin="15,15,15,5"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Author -->
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{Binding AuthorName, StringFormat='by {0}'}" 
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                                           Margin="15,0,15,5" />

                                    <!-- Recipe Stats -->
                                    <StackLayout Grid.Row="3" Grid.Column="0" 
                                                 Orientation="Horizontal" 
                                                 Margin="15,0,15,15">
                                        <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" 
                                               FontSize="12" 
                                               TextColor="#FF9800" />
                                        <Label Text="•" FontSize="12" Margin="8,0" 
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                        <Label Text="{Binding TotalTimeMinutes, StringFormat='{0} min'}" 
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                        <Label Text="•" FontSize="12" Margin="8,0"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                        <Label Text="{Binding Difficulty}" 
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                    </StackLayout>

                                    <!-- Remove Button -->
                                    <Button Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                                            Text="💔"
                                            FontSize="20"
                                            BackgroundColor="Transparent"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            Margin="0,15,15,0"
                                            VerticalOptions="Start"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFromFavoritesCommand}"
                                            CommandParameter="{Binding .}" />

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                    <CollectionView.EmptyView>
                        <ContentView>
                            <StackLayout Padding="50" VerticalOptions="Center">
                                <Label Text="💔" 
                                       FontSize="80" 
                                       HorizontalOptions="Center"
                                       Margin="0,0,0,20" />
                                <Label Text="No Favorites Yet" 
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                                <Label Text="Start exploring recipes and tap the heart icon to add them to your favorites!" 
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,10,0,30"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                <Button Text="Browse Recipes"
                                        BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                                        TextColor="White"
                                        CornerRadius="25"
                                        Padding="30,15"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BrowseRecipesCommand}" />
                            </StackLayout>
                        </ContentView>
                    </CollectionView.EmptyView>
                </CollectionView>

            </StackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>