<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReciptShare.Views.EditProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ReciptShare.ViewModels"
             x:DataType="viewmodels:EditProfileViewModel"
             Title="{Binding Title}"
             Shell.BackButtonBehavior="{x:Null}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Reset" 
                     Command="{Binding ResetFormCommand}"
                     IconImageSource="refresh_icon.png" />
        <ToolbarItem Text="Help" 
                     Command="{Binding ShowPrivacyInfoCommand}"
                     IconImageSource="help_icon.png" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        
        <ScrollView Grid.Row="0" Padding="20">
            <StackLayout Spacing="20">
                
                <!-- Profile Picture Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2D2D30}" 
                       CornerRadius="15" 
                       Padding="20"
                       HasShadow="True">
                    <StackLayout>
                        <Label Text="📸 Profile Picture" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               Margin="0,0,0,15"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                        
                        <!-- Profile Picture Display -->
                        <Frame BackgroundColor="White" 
                               CornerRadius="50" 
                               WidthRequest="100" 
                               HeightRequest="100"
                               HorizontalOptions="Center"
                               Padding="0"
                               HasShadow="True"
                               Margin="0,0,0,15">
                            <Grid>
                                <Ellipse Fill="#E0E0E0" 
                                        WidthRequest="90" 
                                        HeightRequest="90" />
                                <Image Source="{Binding ProfileImageUrl}" 
                                       WidthRequest="90" 
                                       HeightRequest="90"
                                       Aspect="AspectFill" />
                                <Label Text="👤" 
                                       FontSize="40" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding ProfileImageUrl, Converter={StaticResource IsStringNullOrEmptyConverter}}" />
                            </Grid>
                        </Frame>
                        
                        <Button Text="Change Picture"
                                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                                TextColor="White"
                                CornerRadius="20"
                                Command="{Binding ChangeProfilePictureCommand}" />
                        
                        <Entry Placeholder="Or enter profile picture URL..."
                               Text="{Binding ProfileImageUrl}"
                               Keyboard="Url"
                               FontSize="14"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </Frame>

                <!-- Personal Information -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
                       CornerRadius="15" 
                       Padding="20"
                       HasShadow="True">
                    <StackLayout Spacing="15">
                        <Label Text="👤 Personal Information" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                        
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackLayout Grid.Column="0">
                                <Label Text="First Name *" FontSize="14" FontAttributes="Bold" />
                                <Entry Text="{Binding FirstName}" 
                                       Placeholder="Enter first name"
                                       FontSize="16" />
                            </StackLayout>
                            <StackLayout Grid.Column="1">
                                <Label Text="Last Name" FontSize="14" FontAttributes="Bold" />
                                <Entry Text="{Binding LastName}" 
                                       Placeholder="Enter last name"
                                       FontSize="16" />
                            </StackLayout>
                        </Grid>
                        
                        <StackLayout>
                            <Label Text="Username *" FontSize="14" FontAttributes="Bold" />
                            <Entry Text="{Binding Username}" 
                                   Placeholder="Enter username"
                                   FontSize="16" />
                        </StackLayout>
                        
                        <StackLayout>
                            <Label Text="Email Address *" FontSize="14" FontAttributes="Bold" />
                            <Entry Text="{Binding Email}" 
                                   Placeholder="Enter email address"
                                   Keyboard="Email"
                                   FontSize="16" />
                        </StackLayout>
                        
                        <StackLayout>
                            <Label Text="Location (Optional)" FontSize="14" FontAttributes="Bold" />
                            <Entry Text="{Binding Location}" 
                                   Placeholder="e.g., London, UK"
                                   FontSize="16" />
                        </StackLayout>
                        
                        <StackLayout>
                            <Label Text="Website (Optional)" FontSize="14" FontAttributes="Bold" />
                            <Entry Text="{Binding Website}" 
                                   Placeholder="e.g., https://yourwebsite.com"
                                   Keyboard="Url"
                                   FontSize="16" />
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Bio Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
                       CornerRadius="15" 
                       Padding="20"
                       HasShadow="True">
                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="📝 Bio" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Bio.Length, StringFormat='{0}/500'}" 
                                   FontSize="12"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                        </Grid>
                        
                        <Editor Text="{Binding Bio}" 
                                Placeholder="Tell everyone about yourself, your cooking style, favorite cuisines..."
                                FontSize="16"
                                HeightRequest="120"
                                MaxLength="500"
                                Margin="0,10,0,0" />
                        
                        <Label Text="💡 Tip: A good bio helps other food lovers connect with you!" 
                               FontSize="12"
                               FontAttributes="Italic"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                               Margin="0,5,0,0" />
                    </StackLayout>
                </Frame>

                <!-- Privacy & Notifications (Fixed - escaped &) -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}" 
                       CornerRadius="15" 
                       Padding="20"
                       HasShadow="True">
                    <StackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="🔒 Privacy &amp; Notifications" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                            <Button Grid.Column="1"
                                    Text="ℹ️"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Command="{Binding ShowPrivacyInfoCommand}" />
                        </Grid>
                        
                        <!-- Profile Privacy -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Public Profile" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Allow everyone to see your profile and recipes" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                            </StackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding IsPublicProfile}" 
                                    OnColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                                    ThumbColor="White" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" />
                        
                        <!-- Recipe Notifications -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Recipe Notifications" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Get notified about likes and comments on your recipes" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                            </StackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding AllowRecipeNotifications}" 
                                    OnColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                                    ThumbColor="White" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" />
                        
                        <!-- Follower Notifications -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Follower Notifications" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Get notified when someone follows you" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                            </StackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding AllowFollowerNotifications}" 
                                    OnColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                                    ThumbColor="White" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" />
                        
                        <!-- Comment Notifications -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Comment Notifications" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Get notified about new comments" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                            </StackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding AllowCommentNotifications}" 
                                    OnColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                                    ThumbColor="White" />
                        </Grid>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Save/Cancel Buttons -->
        <Frame Grid.Row="1" 
               BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2D2D30}" 
               Padding="20,15" 
               Margin="0" 
               CornerRadius="20,20,0,0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button Grid.Column="0"
                        Text="❌ Cancel"
                        BackgroundColor="{AppThemeBinding Light=#9E9E9E, Dark=#616161}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Command="{Binding GoBackCommand}" />
                
                <Button Grid.Column="1"
                        Text="💾 Save Changes"
                        BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                        Command="{Binding SaveProfileCommand}" />
            </Grid>
        </Frame>

        <!-- Loading Overlay -->
        <Frame Grid.RowSpan="2" 
               BackgroundColor="#80000000" 
               IsVisible="{Binding IsSaving}"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="50" HeightRequest="50" />
                <Label Text="Saving your profile..." FontSize="18" TextColor="White" HorizontalOptions="Center" Margin="0,20,0,0" />
            </StackLayout>
        </Frame>

    </Grid>
</ContentPage>