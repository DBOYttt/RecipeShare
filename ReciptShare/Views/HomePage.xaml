<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReciptShare.Views.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ReciptShare.ViewModels"
             x:DataType="viewmodels:HomeViewModel"
             Title="{Binding Title}">

    <!-- Add API status indicator at the top -->
    <Grid RowDefinitions="Auto,*">
        
        <!-- API Status Bar -->
        <Frame Grid.Row="0" 
               BackgroundColor="{Binding IsApiConnected, Converter={StaticResource BoolToColorConverter}}"
               Padding="10,5"
               Margin="0"
               CornerRadius="0"
               IsVisible="True">
            <Label Text="{Binding IsApiConnected, Converter={StaticResource ApiStatusConverter}}"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>

        <!-- Existing content -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <StackLayout Padding="0">
                    
                    <!-- Welcome Header -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}" 
                           CornerRadius="0,0,30,30"
                           Padding="30,40,30,30"
                           Margin="0,0,0,20">
                        <StackLayout>
                            <Label Text="{Binding CurrentUser.FullName, StringFormat='Welcome back, {0}! 👋'}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            
                            <Label Text="Discover amazing recipes and share your culinary creations!" 
                                   FontSize="16" 
                                   TextColor="#E3F2FD"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,10,0,20" />
                            
                            <Button Text="➕ Add New Recipe"
                                    BackgroundColor="White"
                                    TextColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                                    CornerRadius="25"
                                    Padding="30,15"
                                    FontAttributes="Bold"
                                    Command="{Binding AddNewRecipeCommand}" />
                        </StackLayout>
                    </Frame>

                    <StackLayout Padding="20,0,20,20">
                        
                        <!-- Featured Recipes Section -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                            <Label Grid.Column="0" 
                                   Text="🌟 Featured Recipes" 
                                   FontSize="20" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                            
                            <Button Grid.Column="1"
                                    Text="View All"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}"
                                    FontSize="14"
                                    Command="{Binding ViewAllFeaturedCommand}" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding FeaturedRecipes}"
                                        ItemTemplate="{StaticResource RecipeCardTemplate}"
                                        HeightRequest="300">
                            <CollectionView.EmptyView>
                                <ContentView>
                                    <StackLayout Padding="50" VerticalOptions="Center">
                                        <Label Text="🍽️" FontSize="60" HorizontalOptions="Center" />
                                        <Label Text="No featured recipes available" 
                                               FontSize="18" 
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                        <Label Text="Check your connection or try refreshing" 
                                               FontSize="14" 
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                                               Margin="0,5,0,0" />
                                    </StackLayout>
                                </ContentView>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <!-- Popular Recipes Section -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,30,0,15">
                            <Label Grid.Column="0" 
                                   Text="🔥 Popular Recipes" 
                                   FontSize="20" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                            
                            <Button Grid.Column="1"
                                    Text="View All"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}"
                                    FontSize="14"
                                    Command="{Binding ViewAllPopularCommand}" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding PopularRecipes}"
                                        ItemTemplate="{StaticResource CompactRecipeCardTemplate}"
                                        HeightRequest="400">
                            <CollectionView.EmptyView>
                                <ContentView>
                                    <StackLayout Padding="50" VerticalOptions="Center">
                                        <Label Text="📊" FontSize="60" HorizontalOptions="Center" />
                                        <Label Text="No popular recipes available" 
                                               FontSize="18" 
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                    </StackLayout>
                                </ContentView>
                            </CollectionView.EmptyView>
                        </CollectionView>

                    </StackLayout>
                </StackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>