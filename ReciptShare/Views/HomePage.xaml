<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReciptShare.Views.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ReciptShare.ViewModels"
             x:DataType="viewmodels:HomeViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshDataCommand}">
        <ScrollView>
            <StackLayout Padding="20">
                
                <!-- Welcome Header -->
                <Frame BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2D2D30}" 
                       HasShadow="True" 
                       CornerRadius="10" 
                       Margin="0,0,0,20">
                    <StackLayout>
                        <Label Text="{Binding CurrentUser.Username, StringFormat='Welcome back, {0}!'}" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                        <Label Text="{Binding CurrentUser.Bio}" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    </StackLayout>
                </Frame>

                <!-- Quick Stats -->
                <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,20">
                    <Frame Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A8A}" Margin="5">
                        <StackLayout HorizontalOptions="Center">
                            <Label Text="{Binding CurrentUser.RecipesCount}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="My Recipes" FontSize="12" HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#7B1FA2}" Margin="5">
                        <StackLayout HorizontalOptions="Center">
                            <Label Text="{Binding CurrentUser.FollowersCount}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Followers" FontSize="12" HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#2E7D32}" Margin="5">
                        <StackLayout HorizontalOptions="Center">
                            <Label Text="{Binding CurrentUser.FollowingCount}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Following" FontSize="12" HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <!-- Popular Recipes Section -->
                <Label Text="Popular Recipes" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       Margin="0,20,0,10"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />

                <!-- Popular Recipes List -->
                <CollectionView ItemsSource="{Binding PopularRecipes}"
                                ItemTemplate="{StaticResource CompactRecipeCardTemplate}"
                                HeightRequest="300">
                    <CollectionView.EmptyView>
                        <ContentView>
                            <Label Text="No recipes found" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                        </ContentView>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Add Recipe Button -->
                <Button Text="+ Add New Recipe"
                        BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,20,0,0"
                        Command="{Binding AddNewRecipeCommand}" />

            </StackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>